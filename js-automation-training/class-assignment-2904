/*
IN the given array, we have provided the status of the test cases,  
 
let statuses = ["PASSED", "PASSED", "FAILED", "PASSED", "SKIPPED", "PASSED"];

You have to write a program whose outuput will tell you
- How many test cases passed
- How many failed
- How many skiped.

- Provide the pass percentages.
*/

let statuses = ["PASSED", "PASSED", "FAILED", "PASSED", "SKIPPED", "PASSED"];

let passedCount = 0;
let failedCount = 0;
let skippedCount = 0;

for (let status of statuses) {
    switch (status) {
        case "PASSED":
            passedCount += 1;
            break;
        case "FAILED":
            failedCount += 1;
            break;
        case "SKIPPED":
            skippedCount += 1;
    }


}

console.log("Count of Passed:", passedCount);
console.log("Count of Failed:", failedCount);
console.log("Count of Skipped:", skippedCount);

console.log("Pass Rate =", (passedCount/statuses.length)*100);

